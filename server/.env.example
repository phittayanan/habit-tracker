DATABASE_URL=postgresql://YOUR_LOCAL_ROLE@localhost:5432/habit_tracker
# Tests only: a separate disposable database, never the application database.
TEST_DATABASE_URL=postgresql://YOUR_LOCAL_ROLE@localhost:5432/habit_tracker_test
PORT=3000
# production makes the session cookie Secure (set on GCP); no npm script sets it.
NODE_ENV=development
SEED_MANAGER_PASSWORD=<set-a-private-manager-password>
SEED_PARTICIPANT_PASSWORD=<set-a-private-participant-password>
# SEED_DEMO_DATA=true
